# ───────────────────────────────────────────────────────────
#  거시경제 분석 대시보드 환경설정 (.env 로 복사해서 사용)
#  모든 값은 선택사항입니다. 비워두면 키 없는 무료 소스만 사용합니다.
# ───────────────────────────────────────────────────────────

# 웹 서버
HOST=127.0.0.1
PORT=8000

# 수집 주기 (cron 분 단위). 매시 정각 = "0", 매 30분 = "0,30"
COLLECT_MINUTE=0
# 서버 시작 시 즉시 1회 수집할지
COLLECT_ON_START=true

# ── LLM 시황 브리핑 ──
ENABLE_LLM_BRIEFING=true
# provider 선택: claude(Claude Code CLI 헤드리스, 별도 키 불필요) | gemini(GEMINI_API_KEY REST)
LLM_PROVIDER=claude
# 브리핑/번역 호출 타임아웃(초)
LLM_TIMEOUT=180
# 직전 브리핑 대비 의미 있는 변화가 없으면 재생성을 건너뛴다. 단 직전 브리핑이 이 시간(h)보다 오래되면 새로 작성
BRIEF_MAX_AGE_H=6

# provider=claude 일 때
# claude CLI 실행 파일 경로 (비우면 PATH 에서 자동 탐색)
CLAUDE_BIN=
# 브리핑 모델 (비우면 CLI 기본값). 예: claude-sonnet-4-6, claude-opus-4-8
CLAUDE_MODEL=

# provider=gemini 일 때 (무료 AI Studio 키: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# 브리핑 모델. 예: gemini-2.5-flash, gemini-2.5-pro, gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash
# 번역 모델(가벼운 것 권장). 예: gemini-2.5-flash-lite
GEMINI_TRANSLATE_MODEL=gemini-2.5-flash-lite

# 경제 뉴스 영문→한글 자동 번역 (신규 항목만 번역·캐시)
ENABLE_NEWS_TRANSLATION=true
# claude 번역 모델(가벼운 haiku 권장). 비우면 브리핑 모델 사용
CLAUDE_TRANSLATE_MODEL=haiku
TRANSLATE_TIMEOUT=60

# ── 선택: API 키를 넣으면 해당 소스가 활성화/강화됩니다 ──
# 미국 거시(FRED). 키가 없어도 키 없는 CSV 엔드포인트로 시도합니다.
FRED_API_KEY=
# 한국 거시(한국은행 ECOS). 키가 있어야 활성화됩니다. https://ecos.bok.or.kr/api
ECOS_API_KEY=

# 네트워크
REQUEST_TIMEOUT=20
# 스냅샷/뉴스 보관 일수
HISTORY_DAYS=120
# 차트 이력: 키별 최근 N개 보존(일/월 빈도 무관 — 월별 거시도 다년치 차트)
HISTORY_POINTS=400
